# Database - dùng chung PostgreSQL với twenty-server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/default

# Inactivity threshold (mặc định 30 ngày, test set 5s)
INACTIVITY_THRESHOLD=30d

# Check interval (bao lâu chạy 1 lần)
CHECK_INTERVAL=1h

# Mail driver: log (in console) or smtp (send real email)
MAIL_DRIVER=log

# SMTP settings (chỉ dùng khi MAIL_DRIVER=smtp)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=noreply@twenty.local

# Email reminder template
REMINDER_SUBJECT=We miss you at Twenty CRM
REMINDER_BODY=<p>Hi {{userName}},</p><p>You haven't logged in for {{inactiveDays}} days. We'd love to see you back!</p>
