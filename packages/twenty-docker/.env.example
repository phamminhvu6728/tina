TAG=latest

#PG_DATABASE_USER=postgres
#PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#PG_DATABASE_NAME=default
#REDIS_URL=redis://redis:6379

SERVER_URL=http://localhost:3000

# Use openssl rand -base64 32 for each secret
# ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY= # set to the previous ENCRYPTION_KEY during a rotation
# APP_SECRET= # legacy: only required for instances that pre-date ENCRYPTION_KEY

STORAGE_TYPE=local
# SIGN_IN_PREFILLED=true
# IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false

# ———————— AI (OpenCode + DeepSeek) ————————
# Get a key at https://opencode.ai/
# Put the SAME raw key in OPENCODE_API_KEY and AI_PROVIDERS.apiKey.
# {{VAR}} templates are NOT resolved for custom AI_PROVIDERS (only built-in catalog).
# OPENCODE_API_KEY=
# AI_PROVIDERS={"opencode":{"npm":"@ai-sdk/openai-compatible","name":"opencode","label":"Opencode","baseUrl":"https://opencode.ai/zen/go/v1","apiKey":"YOUR_OPENCODE_KEY","models":[{"name":"deepseek-v4-flash","label":"Tina Flash"}]}}
# AI_MODELS_DEFAULT_FAST=opencode/deepseek-v4-flash
# AI_MODELS_DEFAULT_SMART=opencode/deepseek-v4-flash
# AI_MODELS_DEFAULT_RECOMMENDED=opencode/deepseek-v4-flash

# Optional: Groq instead of / in addition to OpenRouter
# GROQ_API_KEY=
# AI_PROVIDERS={"groq":{"npm":"@ai-sdk/openai-compatible","name":"groq","label":"Groq","baseUrl":"https://api.groq.com/openai/v1","apiKey":"YOUR_KEY","models":[{"name":"llama-3.3-70b-versatile","label":"Llama 3.3 70B"},{"name":"llama-3.1-8b-instant","label":"Llama 3.1 8B Instant"}]}}
# AI_MODELS_DEFAULT_FAST=groq/llama-3.1-8b-instant
# AI_MODELS_DEFAULT_SMART=groq/llama-3.3-70b-versatile
# AI_MODELS_DEFAULT_RECOMMENDED=groq/llama-3.3-70b-versatile

# Exa web search (also set the key on the Exa app after install:
# Settings → Applications → Exa)
# EXA_API_KEY=

# Required for Exa / marketplace app tools (LOCAL or LAMBDA)
LOGIC_FUNCTION_TYPE=LOCAL

# ———————— Google login (OAuth) ————————
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match AUTH_GOOGLE_CALLBACK_URL exactly.
# AUTH_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
# AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=http://localhost:3000/auth/google-apis/get-access-token
# Optional: sync Gmail / Google Calendar inside the CRM
# MESSAGING_PROVIDER_GMAIL_ENABLED=false
# CALENDAR_PROVIDER_GOOGLE_ENABLED=false

# STORAGE_S3_REGION=eu-west3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ———————— INACTIVITY WORKFLOW SERVICE CONFIG ————————
# Ngưỡng thời gian không hoạt động để xác định user inactive (Mặc định: 30d = 30 ngày)
INACTIVITY_THRESHOLD=30d

# Chu kỳ kiểm tra DB (Mặc định: 1h = 1 tiếng 1 lần)
CHECK_INTERVAL=1h

# Cấu hình gửi Mail (SMTP)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER=your-email@gmail.com
REMINDER_SUBJECT=We miss you at Twenty CRM
REMINDER_BODY=<p>Hi {{userName}},</p><p>You haven't logged in for {{inactiveDays}} days. We'd love to see you back!</p>
